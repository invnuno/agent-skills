# Home Assistant base URL used by skills/home-assistant-config/scripts/ha_api.py
HA_URL=http://homeassistant.local:8123

# Home Assistant long-lived access token. Never commit a real token.
HA_TOKEN=replace-with-your-long-lived-access-token

# Optional SSH deployment values used by the deployment reference.
HA_SSH_TARGET=account@host.example
HA_SSH_KEY=/path/to/private-key
HA_CONFIG_DIR=/config
HA_STAGING_DIR=/tmp
